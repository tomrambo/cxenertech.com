# CMMS API (bo-ev-cx-cmms)
# - รับใบสมัคร Sale Freelance Partner
# - ดึงแพ็กเกจสถานีชาร์จ (public charge-packages) สำหรับหน้า /ev-charging/packages
# - ดึงแพ็กเกจโซลาร์ (public solar-packages) สำหรับหน้า /solar/rooftop/packages
# - ดึงบทความ (public posts) สำหรับหน้า /knowledge/articles
# ใช้ตอน `nuxt dev` และตอน deploy Cloudflare Pages (Nitro กลายเป็น Worker)
# ต้องชี้ origin ของ CMMS ที่มี /api/public/charge-packages, /api/public/solar-packages และ /api/public/posts
# ค่าว่างในโค้ดจะ default ไป https://bo-cx-cmms.conceptx.co.th
# รูปแพ็กเกจใช้ค่า image จาก DB (DigitalOcean Spaces) ไม่ใช้ไฟล์ใน public/ เป็นหลัก
NUXT_CMMS_API_BASE_URL="https://bo-cx-cmms.conceptx.co.th"

# Secret ที่ Worker ส่งไป CMMS (ต้องตรงกับ PARTNER_INGEST_SECRET ฝั่ง CMMS)
PARTNER_INGEST_SECRET=""

# ถ้า generate แบบ static แล้วไม่มี Worker — ชี้ตรงไป CMMS public API
# NUXT_PUBLIC_PARTNER_REGISTER_URL="https://bo-cx-cmms.conceptx.co.th/api/public/partners/sale-freelance"

# Deploy Cloudflare Pages
# NITRO_PRESET=cloudflare-pages
